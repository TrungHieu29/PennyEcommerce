@model PennyEcommerce.Models.Product

@{
    ViewData["Title"] = "Product Details";
}

<div class="product-page">
    <h2>Chi tiết sản phẩm</h2>

    <table class="product-table">
        <tr>
            <th>Id</th>
            <td>@Model.Id</td>
        </tr>

        <tr>
            <th>Tên</th>
            <td>@Model.Name</td>
        </tr>

        <tr>
            <th>Giá</th>
            <td>@Model.Price</td>
        </tr>

        <tr>
            <th>Số lượng</th>
            <td>@Model.StockQuantity</td>
        </tr>

        <tr>
            <th>Hoạt động</th>
            <td>@Model.IsActive</td>
        </tr>
    </table>

    <div class="actions" style="margin-top: 15px;">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="simple-link">
            Sửa
        </a>

        <a asp-action="Index" class="simple-link">
            Quay lại
        </a>
    </div>
</div>